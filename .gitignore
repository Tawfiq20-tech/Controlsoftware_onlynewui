# Logs
backend/logs/
*.log
*.ndjson
*.patch
backend/data/*.jsonl
backend/data/remote-access.json

# Frontend build tooling (dist/ stays committed -- backend/index.js serves it
# statically and Tawfiq's machine doesn't run the frontend build itself)
frontend/node_modules/

# Raspberry Pi bundle / image builds
dist-pi/
backend/data/controller_last_seen.json

# Per-machine identity and secrets: regenerated on first boot, and committing
# them would put one shared identity/token on every machine (see the matching
# excludes in pi-kiosk/build-bundle.sh).
backend/data/device-identity.json
backend/data/device-identity.json.bak
backend/data/operator-token
backend/data/cloud-link.json
backend/data/cloud-inbox/
backend/data/job_resume.json
backend/data/job_resume.json.bak
backend/data/job_resume_gcode.nc

# Dependencies are installed per-host, never committed.
node_modules/

# Local snapshot taken before the vertical UI rework; not part of the product.
_backup_before_vertical_industrial_ui/

# The machine's own settings, including remoteDiagToken and the bot tokens.
# A scrubbed backend/data/config.default.json is what ships; ConfigStore seeds
# config.json from it on first boot.
backend/data/config.json
backend/data/config.json.bak
backend/data/config.json.tmp
backend/data/config.json.damaged-*
# A linked WhatsApp account's credentials.
backend/data/whatsapp-session/
# The operator launch link, written at boot when there is no TTY.
backend/data/operator-link.txt
