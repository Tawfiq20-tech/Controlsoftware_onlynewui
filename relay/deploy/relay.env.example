# Onefinity relay environment. Install as /etc/onefinity-relay.env, owner root, mode 0600:
#   sudo install -o root -g root -m 0600 relay.env.example /etc/onefinity-relay.env
# systemd reads it as root before dropping to the onefinity-relay user.
# Plain KEY=VALUE lines only (no quotes, no spaces around =). Invalid values make the
# relay print one "config error:" line per problem and exit 1.

# --- Network -----------------------------------------------------------------
# Bind to loopback only; Caddy terminates TLS on 443 and proxies here. Never expose 8787.
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
# The https:// address phones open. Also used for WebSocket Origin checks and the
# wss:// URL handed to machines during pairing.
RELAY_PUBLIC_URL=https://relay.example.com
# 1 = take the client IP from the last X-Forwarded-For entry when the peer is loopback
# (Caddy). Required behind Caddy, otherwise every client looks like 127.0.0.1 and
# login/pairing rate limits apply to everyone at once.
RELAY_TRUST_PROXY=1
# 1 = allow http:// RELAY_PUBLIC_URL. Refused unless RELAY_HOST is loopback AND the URL
# host is 127.0.0.1/localhost. Local development only; keep 0 on a VPS.
RELAY_ALLOW_INSECURE=0

# --- Storage -----------------------------------------------------------------
# relay.db (SQLite, WAL), blobs/ (staged uploads), secret (cookie HMAC key), backups/.
RELAY_DATA_DIR=/var/lib/onefinity-relay

# --- Accounts ----------------------------------------------------------------
# closed = accounts only via `cli.js create-user`
# invite = register needs an invite code (default; create codes in the web app
#          Account page as admin, or with `cli.js create-invite`)
# open   = anyone can register (reveals whether an email already has an account)
RELAY_SIGNUP=invite

# --- File staging limits -------------------------------------------------------
# Per-file upload cap, 1-100 MB. The machine also enforces its own cap (default 25 MB).
RELAY_MAX_UPLOAD_MB=25
# Per-account storage for files not yet delivered/expired.
RELAY_USER_QUOTA_MB=1024
# All accounts together; must be >= RELAY_MAX_UPLOAD_MB.
RELAY_TOTAL_STORAGE_MB=5120
# Refuse uploads (507) and new pairings (503) below this much free disk in RELAY_DATA_DIR.
RELAY_MIN_FREE_DISK_MB=1024
# Undelivered uploads are deleted after this many days (24 h if the machine never connected).
RELAY_FILE_TTL_DAYS=7

# --- Devices and pairing -------------------------------------------------------
# Machines one account can own, 1-100.
RELAY_MAX_DEVICES_PER_USER=10
# Live (unclaimed) pairing codes across the whole relay.
RELAY_MAX_LIVE_PAIRINGS=1000
# Rotate a machine credential when it is older than this at connect time. 0 disables.
RELAY_CRED_ROTATE_DAYS=90

# --- Camera ------------------------------------------------------------------
# Snapshot rate cap, 1-2 frames per second.
RELAY_SNAPSHOT_MAX_FPS=2
# Largest accepted JPEG, 50-500 KB.
RELAY_SNAPSHOT_MAX_KB=300

# --- Audit and logging ---------------------------------------------------------
RELAY_AUDIT_RETENTION_DAYS=180
# debug | info | warn | error | silent. JSON lines to stdout (journald).
RELAY_LOG_LEVEL=info

# --- Reserved (WebRTC camera, not implemented in v1; ignored) --------------------
#RELAY_TURN_URLS=
#RELAY_TURN_SECRET=
