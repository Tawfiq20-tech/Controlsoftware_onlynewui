# Onefinity kiosk device access.

# USB-serial controllers (CH340, CP210x, FTDI, STM32 CDC): the kiosk user is
# in "dialout"; make sure ttyACM/ttyUSB nodes are in that group.
# ID_MM_DEVICE_IGNORE keeps ModemManager off the controller. It probes any new
# ttyACM looking for a modem and writes AT commands at it, which lands in the
# middle of the sender's own handshake and can drop the link mid-connect. Pi OS
# Lite has no ModemManager, but network-manager (installed for Settings ->
# Wi-Fi) recommends it, so it can appear on an upgrade.
SUBSYSTEM=="tty", KERNEL=="ttyACM[0-9]*|ttyUSB[0-9]*", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"

# STM32 DFU bootloader (firmware update, lib/Firmware/Flashing/DFU.js: 0483:df11).
SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{idProduct}=="df11", GROUP="plugdev", MODE="0664"

# The controller is a serial device and nothing else. If its USB descriptor
# also exposes an HID interface, udev tags it as an input device and libinput
# picks it up -- and a composite device reporting absolute axes can be taken
# for a touchscreen, at which point the compositor may route touch to it and
# the real panel goes dead the moment the controller is plugged in.
# Nothing here should ever read the board as a keyboard, mouse or digitiser.
SUBSYSTEM=="input", ATTRS{idVendor}=="0483", ENV{LIBINPUT_IGNORE_DEVICE}="1"

# USB sticks with G-code: mount under /media/usb-<device> so the file
# picker can open them. No desktop automounter runs on the kiosk.
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", RUN{program}+="/usr/local/bin/onefinity-usb-mount add %k"
ACTION=="remove", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", RUN{program}+="/usr/local/bin/onefinity-usb-mount remove %k"

# Touchscreen re-plugged while the kiosk is running (it can drop off USB for a
# moment when the controller is plugged in): restart the screen so Chromium
# picks touch up again. onefinity-touch-replug ignores the boot-time appearance
# and rate-limits itself.
ACTION=="add", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="onefinity-touch-replug.service"

# Never let the kernel power down the controller or the touchscreen.
#
# USB autosuspend puts an idle device to sleep. A CDC-ACM controller that is
# merely waiting for the next command looks idle, and once suspended the serial
# link goes quiet -- the sender then declares it lost, while the device is still
# plugged in and lsusb still lists it. That is exactly what "it disconnects by
# itself, without anyone touching it" looks like from the front.
#
# -1 disables the idle timer outright; power/control=on keeps it awake even if
# something re-enables runtime PM later.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0483", ATTR{power/autosuspend}="-1", ATTR{power/control}="on"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1a86", ATTR{power/autosuspend}="-1", ATTR{power/control}="on"
# Any USB serial adapter driving a controller, whatever chip it uses.
ACTION=="add", SUBSYSTEM=="usb", DRIVERS=="cdc_acm|ftdi_sio|ch341|cp210x|pl2303", ATTR{power/autosuspend}="-1", ATTR{power/control}="on"
# And the touch panel, so the screen cannot go quiet either.
ACTION=="add", SUBSYSTEM=="usb", ENV{ID_INPUT_TOUCHSCREEN}=="1", ATTR{power/autosuspend}="-1", ATTR{power/control}="on"
